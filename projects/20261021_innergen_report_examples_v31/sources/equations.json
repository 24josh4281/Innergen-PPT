{"title":"감축사업 수식·인자 편집 검증 — 가상 예시","font":"Malgun Gothic","font_size_pt":10.5,"scenarios":[{"id":"reduction","name":"1. 감축량 산정 구조","description":"가상 구조이며 실제 방법론을 지정한 산정 결과가 아닙니다. 누출의 비해당 또는 0 적용은 근거 확인이 필요합니다.","equations":[{"id":"er","label":"식 1","latex":"ER_y = BE_y - PE_y - LE_y"}],"where":[{"symbol":"ER_y","desc":"y년 감축량","unit":"tCO2e/년"},{"symbol":"BE_y","desc":"y년 베이스라인 배출량","unit":"tCO2e/년"},{"symbol":"PE_y","desc":"y년 사업 배출량","unit":"tCO2e/년"},{"symbol":"LE_y","desc":"y년 누출 배출량","unit":"tCO2e/년"}]},{"id":"baseline","name":"2. 베이스라인 산정 예시","description":"전력량과 배출계수의 곱을 설명하는 가상 식입니다. 적용 조건·경계·기간·배출계수 출처는 실제 방법론 확정 후 입력합니다.","equations":[{"id":"be","label":"식 2","latex":"BE_y = EG_y \\times EF_{BL,y}"}],"where":[{"symbol":"EG_y","desc":"y년 순공급 전력량","unit":"MWh/년"},{"symbol":"EF_{BL,y}","desc":"베이스라인 배출계수","unit":"tCO2e/MWh"}]}],"monitoring_parameters":[{"id":"eg","symbol":"EG_y","name":"순공급 전력량","unit":"MWh/년","source":"검침 원장","method":"연속 계측 후 월 집계","frequency":"연속/월","qaqc":"거래 기록 대조 및 계량기 관리 이력 확인"},{"id":"pe","symbol":"PE_y","name":"사업 배출량","unit":"tCO2e/년","source":"하위 산정파일과 활동자료","method":"방법론별 하위 산정식 연결","frequency":"방법론 확정 후 설정","qaqc":"단위·기간·원자료·검토 이력 확인"},{"id":"le","symbol":"LE_y","name":"누출 배출량","unit":"tCO2e/년","source":"해당성 검토 및 하위 산정파일","method":"방법론별 적용 조건 확인","frequency":"방법론 확정 후 설정","qaqc":"임의 0 적용 금지, 비해당 판단 근거 보존"}],"fixed_parameters":[{"id":"ef","symbol":"EF_{BL,y}","name":"베이스라인 배출계수","value":"미입력","unit":"tCO2e/MWh","source":"방법론 지정 출처·지역·연도·판본 확인"}]}
