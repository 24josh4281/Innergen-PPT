  "font": {
    "required_families": [
      "Pretendard",
      "IBM Plex Sans KR",
      "NanumSquare",
      "Noto Sans",
      "Malgun Gothic"
    ]
  },
  "governing": {
    "min_chars": 12,
    "registers": {
      "external": {
        "label": "완결 문장체",
        "endings": [
          "니다",
          "다.",
          "다"
        ],
        "deck_types": [
          "lecture",
          "handout",
          "seminar",
          "proposal",
          "interim",
          "final",
          "insight"
        ]
      },
      "internal": {
        "label": "개조식",
        "endings": [
          "음",
          "임",
          "됨",
          "함",
          "필요",
          "中",
          "예정",
          "검토",
          "요"
        ],
        "deck_types": [
          "kickoff",
          "weekly",
          "biweekly",
          "monthly",
          "diagnosis",
          "benchmark"
        ]
      },
      "promise_endings": [
        "예정입니다",
        "예정임"
      ]
    },
    "forbidden_starts": [
      "이것은",
      "이를 통해",
      "중요한 것은",
      "이는 ",
      "그리고",
      "또한"
    ],
    "forbidden_phrases": [
      "체계적으로 관리",
      "종합적으로 검토",
      "연결이 중요",
      "적극 대응",
      "효과적으로 관리"
    ],
    "question_mark_warn": true,
    "number_pattern": "[0-9０-９]|％|%",
    "duplicate_similarity": 0.9,
    "line_fill_ratio": 0.97
  },
  "title": {
    "min_chars": 4,
    "max_chars": 34,
    "sentence_endings": [
      "다",
      "요",
      "니다",
      "함",
      "음"
    ],
    "numbering_regex": "^\\s*(Ⅰ|Ⅱ|Ⅲ|Ⅳ|Ⅴ|Ⅵ|Ⅶ|Ⅷ|Ⅸ|Ⅹ|[IVX]+\\.|\\d+(\\.\\d+)*\\.?|\\d+-\\d+|부록|참고|도입|맺음|\\[참고\\]|\\[Back-up\\])",
    "repeat_limit": 3,
    "series_marks": [
      "(계속)",
      "/"
    ]
  },
  "toc": {
    "layouts": [
      "innergen-intro-toc",
      "innergen-intro-toc-pages",
      "innergen-biz-toc-pages",
      "innercarry-toc-pages"
    ],
    "divider_layouts": [
      "innergen-intro-section-divider",
      "innergen-biz-section-divider",
      "innercarry-section-divider"
    ],
    "match_min_chars": 4
  },
  "structure": {
    "max_consecutive_same_layout": 4,
    "max_share_single_layout": 0.6,
    "closing_layouts": {
      "lecture": [
        "key-summary",
        "self-check",
        "content-final"
      ],
      "seminar": [
        "key-takeaways",
        "quote-opener"
      ],
      "proposal": [
        "key-takeaways",
        "scope-method-result",
        "purpose-effects"
      ],
      "kickoff": [
        "actor-checklist",
        "key-takeaways",
        "phase-roadmap",
        "gantt-schedule",
        "data-request",
        "decision-request"
      ],
      "weekly": [
        "actor-checklist",
        "progress-plan",
        "decision-request"
      ],
      "monthly": [
        "phase-roadmap",
        "status-board",
        "decision-request"
      ],
      "diagnosis": [
        "entity-matrix",
        "diagnosis-table",
        "priority-matrix"
      ],
      "interim": [
        "key-takeaways",
        "vertical-chevron",
        "status-board",
        "decision-request"
      ],
      "final": [
        "key-takeaways",
        "entity-matrix",
        "exec-one-pager",
        "priority-matrix"
      ],
      "insight": [
        "key-takeaways",
        "key-summary"
      ],
      "biweekly": [
        "progress-plan",
        "decision-request"
      ],
      "briefing": [
        "exec-one-pager"
      ]
    },
    "required_layouts": {
      "lecture": [
        "toc-pages|toc",
        "guidance-focus|case-capture",
        "self-check|key-summary"
      ],
      "kickoff": [
        "toc-pages|toc",
        "project-overview|task-structure",
        "gantt-schedule|phase-roadmap",
        "data-request|actor-checklist"
      ],
      "final": [
        "toc-pages|toc",
        "exec-summary|exec-one-pager|kpi"
      ],
      "weekly": [
        "progress-plan|status-board"
      ],
      "biweekly": [
        "progress-plan|status-board"
      ],
      "diagnosis": [
        "diagnosis-table|maturity-heatmap",
        "priority-matrix|entity-matrix"
      ]
    },
    "note": "레이아웃 키는 계열 접두어(innergen-intro-/innergen-biz-/innercarry-)를 뺀 부분 문자열로 비교한다."
  },
  "source_line": {
    "required_on_layouts_with": [
      "chart",
      "table",
      "evidence",
      "entity-matrix",
      "chart-insight",
      "chart-table",
      "maturity",
      "period",
      "compare"
    ],
    "format_regex": "^출처\\s*[:：]"
  },
  "render_review": [
    "제목·거버닝·출처·푸터가 모든 본문 장표에서 같은 자리에 있는가",
    "거버닝이 한 줄이고 영역 안에서 세로 가운데인가",
    "칸 글자가 넘치거나 잘리지 않는가(표·카드·배지)",
    "강조는 장표당 한 곳인가",
    "같은 질문의 장표가 같은 구조·색·위치인가",
    "사례·예시 수치에 '예시' 표기가 있는가"
  ]
