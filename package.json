{
  "name": "innergen-ppt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:setup": "powershell -ExecutionPolicy Bypass -File scripts/verify-reproducible-setup.ps1",
    "qa:pptx-render": "powershell -ExecutionPolicy Bypass -File scripts/render-pptx-qa.ps1",
    "qa:reference-style": "powershell -ExecutionPolicy Bypass -File scripts/reference-style-qa.ps1",
    "samples:layout": "powershell -ExecutionPolicy Bypass -File scripts/build-layout-sample-deck.ps1",
    "samples:standard-flows": "node scripts/build-standard-flow-sample-decks.mjs",
    "samples:user-input-starstech": "node scripts/build-starstech-user-input-sample.mjs",
    "samples:user-input-starstech:record": "node scripts/record-starstech-user-input-validation.mjs",
    "samples:user-input-cycle": "node scripts/run-user-input-flow-cycle.mjs",
    "generate:pdf": "powershell -ExecutionPolicy Bypass -File scripts/generate-deck-from-pdf.ps1",
    "references:index": "node scripts/build-reference-slide-index.mjs",
    "references:topn": "node scripts/build-reference-topn.mjs",
    "references:refresh": "npm run references:index && npm run references:topn",
    "test:cards": "node scripts/test-card-layout.mjs && python3 -m unittest discover -s tests -p \"test_*.py\" -v"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pdfjs-dist": "^5.7.284",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.4.2"
  }
}
