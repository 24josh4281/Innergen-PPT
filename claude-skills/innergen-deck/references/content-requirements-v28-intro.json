          "level": "WARN",
          "pattern": "ISO\\s?14064|GHG\\s?Protocol",
          "basis": "company-facts innercarry.standards"
        },
        {
          "id": "regulation_source",
          "label": "규제 일정의 출처 표기",
          "level": "WARN",
          "pattern": "출처|자료\\s?:|Source",
