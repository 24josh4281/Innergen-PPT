          "keywords": "회사\\s?개요|Company\\s?Overview"
        },
        {
          "id": "people",
          "label": "구성 인원·전문 인력",
          "required": true,
          "layouts": [
            "team-roles"
          ],
          "keywords": "구성\\s?인원|인력\\s?구성|전문\\s?인력"
        },
        {
          "id": "business_areas",
          "label": "사업 분야 전체(5개 분야)",
          "required": true,
          "layouts": [
            "keyword-grid",
            "entity-matrix"
          ],
          "keywords": "사업\\s?분야|주요\\s?사업"
