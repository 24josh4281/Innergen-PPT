        {
          "id": "track_record",
          "label": "핵심 실적 숫자",
          "required": true,
          "layouts": [
            "content-kpi",
            "year-timeline"
          ],
          "keywords": "실적|성과|Track\\s?Record"
        },
        {
          "id": "closing",
          "label": "맺음(가치·연락처)",
          "required": true,
          "layouts": [
            "ending"
          ],
          "keywords": "We\\s?Do|Thank|문의|연락"
        }
      ],
      "order": [
        "overview",
        "people",
        "business_areas",
        "closing"
      ],
      "items": [
        {
          "id": "founded",
          "label": "설립일",
          "level": "ERROR",
          "pattern": "2017",
          "basis": "company-facts company.founded"
        },
        {
          "id": "ceo",
          "label": "대표자",
          "level": "ERROR",
          "pattern": "김성은|손권빈",
          "basis": "company-facts company.ceo"
        },
        {
          "id": "address",
          "label": "주소",
          "level": "WARN",
          "pattern": "서빙고로",
          "basis": "company-facts company.address"
        },
        {
          "id": "five_areas",
          "label": "5개 사업 분야",
          "level": "WARN",
          "all_of": [
            "규제",
            "배출권|감축",
            "LCA|환경성",
            "공시|CDP",
            "RE100"
