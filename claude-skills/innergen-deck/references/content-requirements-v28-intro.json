      "profile": "company_intro",
      "회사소개": "company_intro",
      "사업소개": "company_intro",
      "innercarry": "innercarry_intro",
      "product_intro": "innercarry_intro",
      "이너캐리": "innercarry_intro"
    }
  },
  "report_types": {
