      ],
      "order": [
        "why_now",
        "service",
        "why_innergen",
        "benefits",
        "adoption",
        "closing"
      ],
      "items": [
        {
          "id": "three_modes",
          "label": "도입 방식 3가지(SaaS·설치형·하이브리드)",
          "level": "WARN",
          "all_of": [
            "SaaS",
            "설치형",
            "하이브리드"
          ],
          "basis": "company-facts innercarry.deployment"
        },
        {
