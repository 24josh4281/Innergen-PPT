          "basis": "company-facts business_areas"
        },
        {
          "id": "kpi",
          "label": "핵심 실적 숫자(업종·인벤토리·방법론·감축실적)",
          "level": "WARN",
          "all_of": [
            "업종",
            "방법론",
            "감축\\s?실적"
          ],
          "basis": "company-facts metrics"
        },
        {
          "id": "contact",
          "label": "연락처(전화·이메일)",
          "level": "WARN",
          "pattern": "6273-0489|innergen@inng\\.co\\.kr",
          "basis": "company-facts company.phone/email"
        }
      ]
    },
    "innercarry_intro": {
